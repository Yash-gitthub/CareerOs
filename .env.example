# ---- Client (bundled into the browser; public values only) ----
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ---- Server secrets: NEVER put these in this file or any VITE_* variable ----
# Set them as Supabase Edge Function secrets instead:
#   supabase secrets set GITHUB_TOKEN=... LLM_API_KEY=...
# GITHUB_TOKEN          public-data read token for GitHub sync (no scopes needed)
# GITHUB_CLIENT_SECRET  only if GitHub OAuth identity linking is enabled
# LLM_API_KEY           AI provider key for roadmap / review / project generation
